# Copy to .env for local dev:  cp .env.example .env
# On your host (Render/Railway/etc.) set these in the dashboard instead.

# Slack Incoming Webhook URL for your contact channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://callybre.com,https://www.callybre.com

# Port (hosts usually set this automatically)
PORT=4000
